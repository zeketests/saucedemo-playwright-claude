{
  "name": "saucedemo-playwright-claude",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:allure": "playwright test && npm run allure:generate",
    "test:ci": "docker run --rm -v .:/workspace -w /workspace mcr.microsoft.com/playwright:v1.59.1-noble npx playwright test",
    "test:ci:ui": "docker run --rm -v .:/workspace -w /workspace mcr.microsoft.com/playwright:v1.59.1-noble npx playwright test --reporter=list",
    "test:shard": "playwright test --shard=$SHARD_INDEX/$SHARD_TOTAL",
    "test:merge": "playwright merge-reports --reporter html,allure-playwright ./blob-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:clean": "rm -rf allure-results allure-report",
    "docker:build": "docker build -t saucedemo-playwright .",
    "docker:test": "docker compose run --rm playwright",
    "docker:test:shard": "docker compose run --rm -e SHARD_INDEX=$SHARD_INDEX -e SHARD_TOTAL=$SHARD_TOTAL playwright npx playwright test --shard=$SHARD_INDEX/$SHARD_TOTAL"
  },
  "keywords": [],
  "author": "Zeke",
  "license": "ISC",
  "description": "A Playwright test suite for SauceDemo created with help from Claude.",
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^25.5.2",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.6.0"
  }
}
